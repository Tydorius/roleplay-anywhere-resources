{
  "_readme": ["The World Frame question bank (plain data, no model calls).",
              "Every question can be skipped and always has an implicit 'Other'",
              "choice with free text; neither is listed here. 'feeds' names the",
              "frame fields (and systems) a question steers, for the docs and the",
              "P0 prompt. 'free' questions take text only. 'multi' allows up to",
              "that many choices. The population range sits beside every form."],
  "population": {"default": [20, 40], "min": 5, "max": 60},
  "short": [
    {"id": "genre", "prompt": "What kind of world?", "multi": 2,
     "options": ["Fantasy", "Science fiction", "Modern day", "Historical",
                 "Post-apocalyptic", "Horror", "Industrial / steampunk"],
     "feeds": ["genre", "setting", "currency"]},
    {"id": "extraordinary", "prompt": "How common is the extraordinary (magic, advanced tech, the supernatural)?",
     "options": ["None, it's grounded", "Rare and mysterious",
                 "Part of everyday life", "It defines society"],
     "feeds": ["reality", "rules", "perks"]},
    {"id": "tone", "prompt": "What tone?",
     "options": ["Cozy", "Adventurous", "Gritty and morally grey",
                 "Dark and dangerous", "Comedic"],
     "feeds": ["tone", "rules", "narrativeFlavor"]},
    {"id": "player", "prompt": "Who is the player?",
     "options": ["A newcomer", "A local with roots", "Someone with authority",
                 "An outcast or fugitive"],
     "feeds": ["playerRole", "quests"]},
    {"id": "drive", "prompt": "What drives the story?",
     "options": ["A mystery", "A threat to survive",
                 "A power struggle between factions", "Personal ambition",
                 "Community and relationships"],
     "feeds": ["conflict", "quests", "calendar"]},
    {"id": "play", "prompt": "What do you mostly want to do?", "multi": 2,
     "options": ["Explore", "Fight", "Talk and scheme", "Trade and craft",
                 "Everyday life"],
     "feeds": ["skills", "perks", "variables", "difficulty"]},
    {"id": "avoid", "prompt": "Anything to avoid?", "free": true,
     "feeds": ["constraints", "rules"]}
  ],
  "medium": [
    {"id": "stakes", "prompt": "What's at stake?",
     "options": ["Personal", "Local", "Regional", "The world", "Cosmic"],
     "feeds": ["stakes", "premise"]},
    {"id": "power", "prompt": "Who holds power here?",
     "options": ["A ruler or noble house", "A church or order",
                 "Merchants or corporations", "Gangs or warlords",
                 "No one, it's contested"],
     "feeds": ["conflict", "premise"]},
    {"id": "source", "prompt": "Where does extraordinary power come from?",
     "options": ["Study", "Birth or bloodline", "Faith", "Technology",
                 "Pacts with outside forces", "Doesn't apply"],
     "feeds": ["reality", "perks"]},
    {"id": "growth", "prompt": "How does the player grow?",
     "options": ["Training and skill", "Gear and wealth",
                 "Reputation and allies", "Forbidden power at a cost"],
     "feeds": ["perks"]},
    {"id": "danger", "prompt": "How dangerous is it?",
     "options": ["Mostly safe", "Some real danger", "Deadly"],
     "feeds": ["difficulty"]},
    {"id": "time", "prompt": "Is there time pressure?",
     "options": ["None", "A slow-building threat", "A hard deadline in days"],
     "feeds": ["variables", "calendar"]},
    {"id": "inspirations", "prompt": "Inspirations: works that capture the feel, and what should be different.",
     "free": true,
     "feeds": ["setting", "tone"]}
  ]
}
